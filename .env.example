# Root-level environment for the e-commerce platform.
# Copy to .env and adjust. Services read these in Docker Compose (see docker-compose.yml).

# Secrets
JWT_SECRET=dev-secret-change-me

# Seeded admin account (used at authservice boot)
ADMIN_EMAIL=admin@boutique.dev
ADMIN_PASSWORD=Admin123!

# Demo customer account (seeded)
DEMO_EMAIL=demo@boutique.dev
DEMO_PASSWORD=Demo123!

POSTGRES_USER=postgres-user
POSTGRES_PASSWORD=postgres-password
POSTGRES_DB=postgresDB


CF_DNS_API_TOKEN=your-cloudflare-edit-zone-dns-token
ACME_EMAIL=you@example.com
