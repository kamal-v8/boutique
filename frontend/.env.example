# Frontend (Next.js BFF) environment. All values default to localhost when unset.
# Copy to frontend/.env to override.

# gRPC service addresses
AUTH_SERVICE_ADDR=localhost:50051
PRODUCT_SERVICE_ADDR=localhost:50052
CART_SERVICE_ADDR=localhost:50053
CHECKOUT_SERVICE_ADDR=localhost:50054
ORDER_SERVICE_ADDR=localhost:50055
PROMOTION_SERVICE_ADDR=localhost:50059

# Optional: override where .proto files are loaded from (default: ../proto from cwd)
# PROTO_DIR=../proto
